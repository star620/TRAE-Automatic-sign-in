<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TraeCheckin</AssemblyName>
    <RootNamespace>TraeCheckin</RootNamespace>
    <Version>1.5.0</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- 统一构建产物输出目录（主程序 + 启动器都输出到这里）。
         使用仓库内相对路径，避免写死到个人账号目录。 -->
    <OutputPath>bin\TraeCheckin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Sodium.Core" Version="1.4.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TraeCheckin.Tests" />
  </ItemGroup>

  <!-- 排除启动器子项目，避免主项目默认 glob 把它的源码和 obj 中间文件一起编译进来 -->
  <ItemGroup>
    <Compile Remove="TraeCheckin.Launcher\**" />
    <EmbeddedResource Remove="TraeCheckin.Launcher\**" />
    <Content Remove="TraeCheckin.Launcher\**" />
    <None Remove="TraeCheckin.Launcher\**" />
  </ItemGroup>

</Project>